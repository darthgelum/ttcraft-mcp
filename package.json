{
  "name": "ttcraft-mcp",
  "version": "0.1.2",
  "description": "Build and script TTCraft tables from Claude Code, Codex and any MCP client.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ttcraft-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "reference",
    "examples",
    "docs",
    "media",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:native": "npm run build && node test/native-smoke.mjs",
    "test:package": "node test/package-smoke.mjs",
    "start": "node dist/index.js",
    "sync-reference": "node scripts/sync-reference.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darthgelum/ttcraft-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/darthgelum/ttcraft-mcp/issues"
  },
  "homepage": "https://ttcraft.net/docs/mcp",
  "keywords": [
    "ttcraft",
    "mcp",
    "tabletop",
    "board-game",
    "lua",
    "claude",
    "codex"
  ]
}
