{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ES2022",
    "lib": ["ES2023", "DOM"], "outDir": "dist", "rootDir": "src",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "declaration": true
  },
  "include": ["src"]
}
